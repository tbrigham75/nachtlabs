# Non-secret API configuration. Use scripts/configure.py to create per-service files.
NACHTLABS_ENV=production
NACHTLABS_PUBLIC_URL=https://nachtlabs.example.invalid
NACHTLABS_ALLOWED_HOSTS=nachtlabs.example.invalid,localhost,127.0.0.1
# Extra browser origins to answer on, comma separated and exact. Each host must also
# appear in NACHTLABS_ALLOWED_HOSTS. Empty means NACHTLABS_PUBLIC_URL only.
NACHTLABS_ALLOWED_ORIGINS=
NACHTLABS_DATABASE_URL_FILE=/etc/nachtlabs/credentials/api-db
NACHTLABS_MASTER_KEY_FILE=/etc/nachtlabs/credentials/master-key
NACHTLABS_MASTER_KEY_ID=v1
NACHTLABS_BOOTSTRAP_TOKEN_FILE=/etc/nachtlabs/credentials/bootstrap-token
NACHTLABS_SESSION_IDLE_SECONDS=1800
NACHTLABS_SESSION_ABSOLUTE_SECONDS=43200

NACHTLABS_INTEGRATION_NETWORK_ENABLED=false
NACHTLABS_GIT_PROVIDER_NETWORK_ENABLED=false
# Permit cleartext HTTP to a provider on your own network. Off by default.
# When on, the model request and the model's reply both travel unprotected,
# so anything on the network path can read the former and forge the latter.
# It never covers a publicly routable address, and does not apply to agent
# execution, which the root execution catalog gates separately.
NACHTLABS_INTEGRATION_ALLOW_HTTP_PRIVATE=false
