# Copy to .env for operator-run Linux development. Never put raw credentials here.
NACHTLABS_ENV=development
NACHTLABS_PUBLIC_URL=http://localhost:3000
NACHTLABS_ALLOWED_HOSTS=localhost,127.0.0.1
# Extra browser origins to answer on, comma separated and exact.
# Every host listed here must also appear in NACHTLABS_ALLOWED_HOSTS.
# Empty means NACHTLABS_PUBLIC_URL only, which is the normal case.
NACHTLABS_ALLOWED_ORIGINS=
NACHTLABS_DATABASE_URL_FILE=/etc/nachtlabs/credentials/api-db
NACHTLABS_MIGRATION_DATABASE_URL_FILE=/etc/nachtlabs/credentials/migration-db
NACHTLABS_MASTER_KEY_FILE=/etc/nachtlabs/credentials/master-key
NACHTLABS_MASTER_KEY_ID=v1
NACHTLABS_BOOTSTRAP_TOKEN_FILE=/etc/nachtlabs/credentials/bootstrap-token
NACHTLABS_INTERNAL_API_URL=http://127.0.0.1:8000
NACHTLABS_SMTP_HOST=
NACHTLABS_SMTP_PORT=587
NACHTLABS_SMTP_TLS_MODE=starttls
NACHTLABS_SMTP_FROM=nachtlabs@example.invalid
NACHTLABS_SMTP_USERNAME=
NACHTLABS_SMTP_PASSWORD_FILE=/etc/nachtlabs/credentials/smtp-password
NACHTLABS_BACKUP_DIR=/var/backups/nachtlabs
NACHTLABS_BACKUP_RECIPIENT=<age-public-recipient>

NACHTLABS_INTEGRATION_NETWORK_ENABLED=false
NACHTLABS_GIT_PROVIDER_NETWORK_ENABLED=false
